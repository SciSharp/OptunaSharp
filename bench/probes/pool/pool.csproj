<Project Sdk="Microsoft.NET.Sdk">

  <!-- README "Parallel trials", the waiting-trials sentence: trials that sleep rather than compute, at nJobs above the core
       count, under bench/common/Bench.cs's warm-up-then-measure protocol. Release, against this checkout's src/. Not in the
       solution: bench/publish.sh builds every probe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OptunaSharp.Core/OptunaSharp.Core.csproj" />
    <Compile Include="../../common/ProbeEnv.cs" />
    <Compile Include="../../common/Bench.cs" />
  </ItemGroup>

</Project>
