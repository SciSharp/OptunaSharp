<Project Sdk="Microsoft.NET.Sdk">

  <!-- README "Large studies" table and the compact-storage numbers (README's memory paragraph, docs/website-src/docs/
       performance.md): plan 13's proof workloads (40 floats, seed 0, default samplers) on InMemoryStorage with and without
       compactFinishedTrials, under bench/common/Bench.cs's warm-up-then-measure protocol. Prints a hash of every trial, so equal
       hashes against Python Optuna (py/pbench.py builds the same hash) prove OptunaSharp ran Optuna's exact trials. Release,
       against this checkout's src/. Not in the solution: bench/publish.sh builds every probe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OptunaSharp.Core/OptunaSharp.Core.csproj" />
    <Compile Include="../../common/ProbeEnv.cs" />
    <Compile Include="../../common/Bench.cs" />
  </ItemGroup>

</Project>
