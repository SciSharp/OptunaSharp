<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp.Integration.Pruning</AssemblyName>
    <Nullable>enable</Nullable>

    <!-- NuGet package identity. Shared metadata (Authors/Company/Copyright/RepositoryUrl/
         license/version) is centralized in ../../Directory.Build.props.

         THE NAMED PRUNING CALLBACKS. This satellite hosts the faithful ports of every remaining
         optuna_integration.*PruningCallback / *PruningHandler / *PruningHook — CatBoost, XGBoost,
         Keras, tf.keras, TensorFlow (estimator), PyTorch Ignite, PyTorch Lightning, skorch and
         fastai v2 (plus the FastAIPruningCallback alias Optuna exports). Unlike the ML.NET / LightGBM
         integrations, NONE of these callbacks needs a foreign ML runtime: in Python the framework
         invokes the callback and hands it the per-iteration evaluation data; here — exactly as the
         already-shipped LightGBMPruningCallback does — the callback consumes that data modeled as
         plain C# structures and is driven from the caller's own training loop (no .NET GBM/DL trainer
         exposes a managed per-iteration hook). That makes this package PURE MANAGED (Core only), so it
         does not fragment into one premature heavy-runtime package per framework: one pure-managed
         package holds them all, one source file per Optuna module so the C# diffs against the Python.

         The framework-agnostic PruningCallback (report -> should_prune -> raise, plus the CatBoost-style
         deferred check) ships in OptunaSharp.Integration.ML.NET, and LightGBMPruningCallback in
         OptunaSharp.Integration.LightGbm (each co-located with its runtime dependency). This package is
         the home for the callbacks that have NO such runtime dependency. -->
    <PackageId>OptunaSharp.Integration.Pruning</PackageId>
    <Description>The named framework pruning callbacks for OptunaSharp (a .NET port of Optuna): faithful ports of the remaining optuna_integration pruning callbacks — CatBoostPruningCallback, XGBoostPruningCallback, KerasPruningCallback, TFKerasPruningCallback, TensorFlowPruningHook, PyTorchIgnitePruningHandler, PyTorchLightningPruningCallback, SkorchPruningCallback and FastAIV2PruningCallback (plus the FastAIPruningCallback alias). Each reports the current validation metric to the trial and prunes an unpromising trial via the study's pruner, matching Optuna's per-callback metric lookup, step semantics, warnings and verbatim messages. A Phase-6 adapter: since no .NET ML/DL trainer exposes a managed per-iteration hook, each callback consumes the framework's per-iteration evaluation data modeled as plain C# structures and is driven from your own training loop (the same convention as OptunaSharp's LightGBMPruningCallback). Pure managed — depends only on Core (no foreign ML runtime). For the framework-agnostic report/should-prune helper see OptunaSharp.Integration.ML.NET's PruningCallback; for LightGBM see OptunaSharp.Integration.LightGbm. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;Integration;Pruning;PruningCallback;CatBoost;XGBoost;Keras;TensorFlow;PyTorch;Ignite;Lightning;skorch;fastai;HyperparameterOptimization;HPO;AutoML;SciSharp</PackageTags>

    <!-- Emit the XML doc file (for IntelliSense) but do not fail the build on missing/malformed
         doc comments — the surface is ported to match Optuna, not curated per-member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <!-- Emit the .pdb inside the .nupkg (the release pipeline pushes only *.nupkg). -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>

    <!-- Strong-naming (key, SignAssembly, DelaySign) is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Reuse the shared OptunaSharp package icon. -->
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is in-repo, so reference it by project. Packing records a clean "OptunaSharp" package
         dependency. Core provides Trial / Study / TrialPruned / StudyDirection + NumSharp
         (ValueError / KeyError), and — granted via InternalsVisibleTo in Core's Assembly/Properties.cs
         — the internal OptunaWarnings seam (the Keras/tf.keras/Lightning missing-metric UserWarning)
         and the internal storage surface the PyTorch Lightning DDP path needs (Trial.Storage /
         Trial.TrialId / Study.Storage / CachedStorage / ICachedStorageBackend). This is the ONLY
         dependency: pure managed, no foreign ML runtime. -->
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
