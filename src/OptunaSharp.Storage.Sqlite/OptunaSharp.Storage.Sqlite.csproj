<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp.Storage.Sqlite</AssemblyName>
    <Nullable>enable</Nullable>

    <PackageId>OptunaSharp.Storage.Sqlite</PackageId>
    <Description>SQLite RDB storage for OptunaSharp — the port of optuna.storages.RDBStorage on Microsoft.Data.Sqlite. Persists a study to a local .db file with Optuna's exact schema (alembic v3.2.0.a, schema_version 12), so Python Optuna and OptunaSharp can open the same database file. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;SQLite;RDB;Storage;Database;HyperparameterOptimization;HPO;SciSharp</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- Optional Microsoft.Extensions.DependencyInjection wire-up (OptunaSharp.Storages.Extensions).
       Pure-managed abstractions; version single-sourced in ../../Directory.Build.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
