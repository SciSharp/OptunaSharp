<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp</AssemblyName>

    <!-- NuGet package identity. Shared metadata (Authors/Company/Copyright/RepositoryUrl/
         license/version) is centralized in ../../Directory.Build.props. -->
    <PackageId>OptunaSharp</PackageId>
    <Description>OptunaSharp is a .NET port of Optuna 5.x, the define-by-run hyperparameter optimization framework, for C# and F#, built on NumSharp. It brings Optuna's study and trial API with its samplers (TPE, CMA-ES, GP, QMC, NSGA-II, NSGA-III, Grid, Random, BruteForce and more), pruners, distributions, in-memory and journal storages, parameter importance, terminators and the visualization data layer. Names, defaults and error messages follow Optuna, and the test suite checks seeded runs against live Python Optuna. Database storages, plotting, ML integrations, the CLI and the Python bridges ship as separate OptunaSharp.* packages. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;HyperparameterOptimization;HPO;AutoML;MachineLearning;Bayesian;TPE;SciSharp;NumSharp</PackageTags>

    <!-- Emit the XML doc file (for IntelliSense) but do not fail the build on missing/malformed
         doc comments — the surface is ported to match Optuna, not curated per-member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <!-- Emit the .pdb inside the .nupkg (the release pipeline pushes only *.nupkg). -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>

    <!-- Strong-naming (key, SignAssembly, DelaySign) is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- NuGet package icon (256x256 square crop of the OptunaSharp logo image). -->
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- ================================================================================
       NumSharp — the numerical foundation — and NumSharp.Interop.OpenBLAS — its native
       LAPACK/CBLAS backend — are consumed from NuGet (SciSharp STACK, nuget.org). The
       version is single-sourced as $(NumSharpVersion) in ../../Directory.Build.props.

       OpenBLAS ships the prebuilt scipy-openblas binaries NumPy itself bundles (as
       runtimes/<rid>/native/*, auto-copied to output by the package's buildTransitive
       targets), so once referenced — the backend force-loaded by the [ModuleInitializer]
       in Internal/OpenBlasActivation.cs — NumSharp's np.linalg (cholesky / eigh / solve /
       matrix_rank / svd / qr) computes through LAPACK and is BIT-IDENTICAL to NumPy
       (verified byte-for-byte vs numpy 2.4.2). This is what makes the linalg-backed samplers
       (NSGA-III's hyperplane solve, CMA-ES's eigendecomposition, the GP stack's Cholesky)
       byte-exact rather than managed-tolerance. Per the maintainer's decision this is a
       first-class Core dependency (a documented departure from the plan's original
       "Core = zero-native-deps" framing): "use NumSharp + OpenBLAS any time Optuna uses NumPy."

       OpenBLAS itself depends on the same NumSharp version, so both are recorded as direct
       package dependencies on pack. The matching NumSharp SOURCE is vendored reference-only at
       refs/NumSharp, pinned to the same release tag — for browsing / LLM cross-referencing,
       NOT for the build (build + CI restore these from nuget.org, always).
       ================================================================================ -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="$(NumSharpVersion)" />
    <PackageReference Include="NumSharp.Interop.OpenBLAS" Version="$(NumSharpVersion)" />
  </ItemGroup>

  <!-- ================================================================================
       Microsoft.Extensions.DependencyInjection.Abstractions — the ONLY dependency of the
       optional DI wire-up in the OptunaSharp.Extensions namespace (AddOptunaSampler /
       AddOptunaPruner / AddOptunaStorage / AddOptunaStudyFactory). It is pure managed and
       BCL-adjacent (NOT a foreign runtime — the rule that pushes ML.NET / TorchSharp / Redis /
       SQLite into satellite packages does not trigger here), so Core keeps its "no foreign
       runtime" guarantee. Version single-sourced as $(MicrosoftExtensionsDIVersion) in
       ../../Directory.Build.props. A consumer that never touches the DI extensions still
       resolves it (it is a hard package dependency), but pays no runtime cost for it.
       ================================================================================ -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDIVersion)" />
  </ItemGroup>

</Project>
