<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp</AssemblyName>

    <!-- NuGet package identity. Shared metadata (Authors/Company/Copyright/RepositoryUrl/
         license/version) is centralized in ../../Directory.Build.props. -->
    <PackageId>OptunaSharp</PackageId>
    <Description>OptunaSharp is a .NET port of Optuna, the hyperparameter optimization framework. It brings Optuna's define-by-run study/trial API — samplers, pruners, distributions, and storages — to C# and F#, built on top of NumSharp for numerical work. This is early scaffolding: the algorithm surface is not yet ported.</Description>
    <PackageTags>Optuna;OptunaSharp;HyperparameterOptimization;HPO;AutoML;MachineLearning;Bayesian;TPE;SciSharp;NumSharp</PackageTags>

    <!-- Emit the XML doc file (for IntelliSense) but do not fail the build on missing/malformed
         doc comments — the surface is ported to match Optuna, not curated per-member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <!-- Emit the .pdb inside the .nupkg (the release pipeline pushes only *.nupkg). -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>

    <!-- Strong-naming (key, SignAssembly, DelaySign) is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- NuGet package icon (256x256 square crop of the OptunaSharp logo image). -->
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- ================================================================================
       NumSharp reference — "csproj for now, nuget in future".

       When a SIBLING NumSharp checkout is present (the local dev layout: K:\source\NumSharp
       beside K:\source\OptunaSharp), reference it by PROJECT so changes flow live. On a
       standalone checkout / CI runner (no sibling), fall back to the published NuGet package
       so the repo builds on its own. The two are mutually exclusive on Exists(...), so exactly
       one applies and pack always records a "NumSharp" package dependency either way.
       ================================================================================ -->
  <!-- The sibling path can be overridden (e.g. -p:NumSharpCoreProject=<path> or an env var) to
       point at a pinned checkout/worktree — useful when the sibling working tree is mid-edit. -->
  <PropertyGroup>
    <!-- Prefer the in-repo NumSharp submodule (src/NumSharp, pinned to journey3 — the canonical
         reference now); fall back to a sibling checkout (K:\source\NumSharp) if the submodule
         isn't initialised. -->
    <NumSharpCoreProject Condition="'$(NumSharpCoreProject)' == '' And Exists('$(MSBuildThisFileDirectory)..\NumSharp\src\NumSharp.Core\NumSharp.Core.csproj')">$(MSBuildThisFileDirectory)..\NumSharp\src\NumSharp.Core\NumSharp.Core.csproj</NumSharpCoreProject>
    <NumSharpCoreProject Condition="'$(NumSharpCoreProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\NumSharp\src\NumSharp.Core\NumSharp.Core.csproj</NumSharpCoreProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NumSharpCoreProject)')">
    <ProjectReference Include="$(NumSharpCoreProject)" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(NumSharpCoreProject)')">
    <PackageReference Include="NumSharp" Version="0.60.0" />
  </ItemGroup>

  <!-- ================================================================================
       NumSharp.Interop.OpenBLAS — the native LAPACK/CBLAS backend, referenced the same
       "csproj now, nuget later" way as NumSharp.Core.

       It ships the prebuilt scipy-openblas 0.3.31 binaries NumPy itself bundles, so once
       referenced (the backend auto-registers via a [ModuleInitializer]) NumSharp's np.linalg
       — cholesky / eigh / solve / matrix_rank / svd / qr — computes through LAPACK and is
       BIT-IDENTICAL to NumPy (verified: cholesky/eigh values+vectors/solve match numpy 2.4.2
       byte-for-byte). This is what makes the linalg-backed samplers (NSGA-III's hyperplane
       solve, CMA-ES's eigendecomposition, the GP stack's Cholesky) byte-exact rather than
       managed-tolerance. Per the maintainer's decision this is a first-class Core dependency
       (a documented departure from the plan's original "Core = zero-native-deps" framing):
       "use NumSharp + OpenBLAS any time Optuna uses NumPy."

       NOTE: NumSharp.Interop.OpenBLAS is not yet published to nuget.org, so the PackageReference
       fallback only restores once it is released; the in-repo sibling ProjectReference is the
       working path today.
       ================================================================================ -->
  <PropertyGroup>
    <!-- Same submodule-first, sibling-fallback resolution as NumSharp.Core above. -->
    <NumSharpOpenBlasProject Condition="'$(NumSharpOpenBlasProject)' == '' And Exists('$(MSBuildThisFileDirectory)..\NumSharp\src\NumSharp.Interop.OpenBLAS\NumSharp.Interop.OpenBLAS.csproj')">$(MSBuildThisFileDirectory)..\NumSharp\src\NumSharp.Interop.OpenBLAS\NumSharp.Interop.OpenBLAS.csproj</NumSharpOpenBlasProject>
    <NumSharpOpenBlasProject Condition="'$(NumSharpOpenBlasProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\NumSharp\src\NumSharp.Interop.OpenBLAS\NumSharp.Interop.OpenBLAS.csproj</NumSharpOpenBlasProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NumSharpOpenBlasProject)')">
    <ProjectReference Include="$(NumSharpOpenBlasProject)" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(NumSharpOpenBlasProject)')">
    <PackageReference Include="NumSharp.Interop.OpenBLAS" Version="0.60.0" />
  </ItemGroup>

</Project>
