<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>OptunaSharp.Interop.BoTorch</AssemblyName>
    <RootNamespace>OptunaSharp.Interop.BoTorch</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet package identity. Shared metadata (Authors/Company/Copyright/RepositoryUrl/license/
         version) is centralized in ../../Directory.Build.props. This is a Tier X satellite that ships
         SEPARATELY because it takes a foreign-runtime dependency (an embedded CPython + PyTorch/BoTorch
         via pythonnet) — Core stays pure managed (NumSharp only), the NumSharp.Interop.OpenBLAS /
         OptunaSharp.Interop.pythonnet pattern.

         Purpose: BoTorchSampler as a first-class OptunaSharp sampler that drives the REAL BoTorch
         (PyTorch + GPyTorch) library in-process — a faithful C# port of optuna_integration's
         `BoTorchSampler` glue (the sampler protocol + the candidates_func selection) that makes every
         numerical step (SingleTaskGP, fit_gpytorch_mll, the acquisition functions, optimize_acqf) a
         direct call into botorch. This gives the genuine article — byte-exact with BoTorch, the full
         acquisition suite, a custom candidates_func, and device= GPU — while the Optuna side is native
         OptunaSharp. It does NOT depend on the Python `optuna_integration` package (we port it);
         users install only `botorch`. Built on OptunaSharp.Interop.pythonnet. -->
    <PackageId>OptunaSharp.Interop.BoTorch</PackageId>
    <Description>BoTorchSampler for OptunaSharp — a native OptunaSharp BaseSampler that drives the real BoTorch (PyTorch + GPyTorch) library in-process via Python.NET (pythonnet). A faithful C# port of optuna_integration's BoTorchSampler glue (sampler protocol + candidates_func selection) whose numerics are direct botorch calls, so it is byte-exact with BoTorch. You pick the acquisition function with the pythonnet-free BoTorchCandidatesFunc enum (Phase A: LogEI/qEI/qLogEI/qNEI; multi-objective, constraints, and knowledge-gradient follow). Does NOT require the Python optuna_integration package — install only `botorch`. The .NET analog of using optuna_integration.BoTorchSampler, built on OptunaSharp.Interop.pythonnet. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;BoTorch;PyTorch;GPyTorch;BayesianOptimization;pythonnet;Python.NET;interop;sampler;GaussianProcess;BlackBoxOptimization;HyperparameterOptimization;HPO;AutoML;SciSharp</PackageTags>

    <!-- Emit the XML doc file (for IntelliSense) but do not fail the build on doc-comment nits. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <!-- Emit the .pdb inside the .nupkg (the release pipeline pushes only *.nupkg). -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>

    <!-- Strong-naming (key, SignAssembly, DelaySign) is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Reuse the shared OptunaSharp package icon. -->
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime plumbing (embedded CPython, GIL wrappers, interpreter discovery, CLR<->Py marshaling)
         comes from the pythonnet interop package; it transitively brings pythonnet [3.0.5,4.0.0). -->
    <ProjectReference Include="..\OptunaSharp.Interop.pythonnet\OptunaSharp.Interop.pythonnet.csproj" />
    <!-- NumSharp's zero-copy pythonnet interop: the NDArray <-> numpy <-> torch crossing
         (NDArray.ToTorch / PyObject.ToTorchNDArray) the tensor marshaling rides on instead of
         per-element PyList/tolist loops. Version single-sourced with Core's NumSharp via
         $(NumSharpVersion). It requires an already-initialized PythonEngine, so it wires onto the
         SAME embedded engine OptunaSharp.Interop.pythonnet starts (it does not start its own). -->
    <PackageReference Include="NumSharp.Interop.pythonnet" Version="$(NumSharpVersion)" />
    <!-- Core is referenced by project; packing records a clean "OptunaSharp" dependency. This package
         is a Core FRIEND (InternalsVisibleTo in Core's Assembly/Properties.cs) so it reuses the
         bit-exact one-hot SearchSpaceTransform + the intersection search space + the warning seam. -->
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

  <!-- Optional Microsoft.Extensions.DependencyInjection wire-up (OptunaSharp.Interop.BoTorch.Extensions).
       Declared directly (the extension uses IServiceCollection) though Core also flows it transitively;
       pure-managed abstractions, version single-sourced in ../../Directory.Build.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDIVersion)" />
  </ItemGroup>

</Project>
