<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp.Storage.ServiceStack.Redis</AssemblyName>

    <PackageId>OptunaSharp.Storage.ServiceStack.Redis</PackageId>
    <Description>Redis journal-log backend for OptunaSharp on ServiceStack.Redis. ServiceStackJournalRedisBackend persists an Optuna study's operation log to a Redis server (standalone or cluster), byte-compatible with Python Optuna and the sibling StackExchange/NRedisStack backends. NOTE: ServiceStack.Redis is COMMERCIALLY licensed (its free tier is request-quota-limited) — see the package README. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;Redis;ServiceStackRedis;Storage;Journal;HyperparameterOptimization;HPO;SciSharp</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- COMMERCIAL LICENSE: ServiceStack.Redis' free tier is request-quota-limited. See the README. -->
    <PackageReference Include="ServiceStack.Redis" Version="10.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptunaSharp.Storage.Redis\OptunaSharp.Storage.Redis.csproj" />
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
