<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp.Integration.ML.NET</AssemblyName>

    <!-- NuGet package identity. Shared metadata (Authors/Company/Copyright/RepositoryUrl/
         license/version) is centralized in ../../Directory.Build.props. This is a Tier X satellite:
         it pulls a foreign runtime (ML.NET's FastForest / native FastTree), so it ships separately
         and Core stays pure managed — the NumSharp.Interop.OpenBLAS optional-package pattern.

         THE ML.NET INTEGRATION. This one package hosts every ML.NET-backed importance evaluator that
         rides the Microsoft.ML.FastTree runtime — the FastForest bagging ensemble and the
         FastTree / FastTreeTweedie gradient boosters. (LightGBM keeps its own package,
         OptunaSharp.Integration.LightGbm, because it carries a distinct heavy native runtime —
         Microsoft.ML.LightGbm, per-RID binaries — and maps 1-to-1 to Optuna's own
         optuna.integration.lightgbm module + tuner: one package per heavy native dep.)

         The canonical fANOVA/MDI evaluators (FanovaImportanceEvaluator /
         MeanDecreaseImpurityImportanceEvaluator) ship in Core (OptunaSharp, namespace
         OptunaSharp.Importance) as a pure-managed, bit-exact port of scikit-learn's
         RandomForestRegressor (value-parity with Python Optuna). This package's public evaluators keep
         their own child namespaces — OptunaSharp.Importance.Forests (the faithful FastForest backend)
         and OptunaSharp.Importance.Booster (the EXPERIMENTAL / off-label gradient boosters) — so the
         "which is the real one" question is answered by the namespace, and the .ML.NET assembly suffix
         marks the ML.NET dependency, distinct from Core's pure-managed OptunaSharp. -->
    <PackageId>OptunaSharp.Integration.ML.NET</PackageId>
    <Description>The ML.NET integration for OptunaSharp (a .NET port of Optuna): ML.NET-backed forest parameter-importance evaluators over the Microsoft.ML.FastTree runtime. A faithful FastForest backend — FastForestFanovaImportanceEvaluator (fANOVA — Hutter et al. 2014) and FastForestMeanDecreaseImpurityImportanceEvaluator (MDI) — plus EXPERIMENTAL / off-label gradient-boosted-tree backends (ML.NET FastTree and FastTreeTweedie): FastTree/FastTreeTweedie {Fanova,MeanDecreaseImpurity}ImportanceEvaluator. The canonical FanovaImportanceEvaluator / MeanDecreaseImpurityImportanceEvaluator ship in Core as a pure-managed, bit-exact port of scikit-learn's RandomForestRegressor (value-parity with Python Optuna); FastForest fits that same bagging model with ML.NET (ranking parity — values diverge, not tree-identical to scikit-learn), while the boosters fit the ensemble residual rather than the objective, so fANOVA/MDI over them is off-label — a non-standard quantity with NO value-parity to Optuna (weak ranking agreement at best). Prefer the canonical Core evaluators when Optuna parity matters. Also ships the ML.NET backend for the Core OptunaSearchCV (the Phase-6 optuna.integration analog): MLNetEstimator, the ICrossValidationEstimator that cross-validates an arbitrary ML.NET pipeline — an adapter (validated by usage, not bit-parity), since ML.NET is not scikit-learn. (OptunaSearchCV itself, the ICrossValidationEstimator seam, and the byte-exact native scikit-learn backend all live in Core — the latter under namespace OptunaSharp.Integration.Sklearn.) The framework-agnostic PruningCallback — for driving pruning from your own training loop — lives in Core (OptunaSharp) as the base that framework integration packages extend. LightGBM lives in the separate OptunaSharp.Integration.LightGbm package (distinct heavy native runtime + Optuna tuner identity). Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;Integration;MLNET;OptunaSearchCV;GridSearchCV;CrossValidation;Importance;fANOVA;MDI;RandomForest;FastForest;FastTree;FastTreeTweedie;GradientBoosting;HyperparameterOptimization;HPO;AutoML;SciSharp</PackageTags>

    <!-- Emit the XML doc file (for IntelliSense) but do not fail the build on missing/malformed
         doc comments — the surface is ported to match Optuna, not curated per-member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <!-- Emit the .pdb inside the .nupkg (the release pipeline pushes only *.nupkg). -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>

    <!-- Strong-naming (key, SignAssembly, DelaySign) is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Reuse the shared OptunaSharp package icon. -->
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ML.NET's FastForest (the analogue of Optuna's sklearn.ensemble.RandomForestRegressor) and the
         FastTree / FastTreeTweedie gradient boosters all live in Microsoft.ML.FastTree, which also
         carries the RegressionTree structure the fANOVA tree-walk + MDI read; Microsoft.ML carries
         MLContext / IDataView / LoadFromEnumerable. Both MIT, native FastTree binaries per RID. The
         boosters introduce NO new native dependency beyond FastForest's. -->
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is in-repo, so reference it by project. Packing records a clean "OptunaSharp" package
         dependency. Core transitively provides NumSharp (ValueError) + the internal
         SearchSpaceTransform / ImportanceBase helpers / SklearnLikeTree / ForestImportance / intersection
         search space / OptunaWarnings these evaluators reach (granted via InternalsVisibleTo in Core's
         Assembly/Properties.cs). -->
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ML.NET tree-ensemble -> SklearnLikeTree adapter is shared by every ML.NET importance
         backend — this package's FastForest + FastTree/FastTreeTweedie evaluators and the separate
         OptunaSharp.Integration.LightGbm package. It is a linked source file rather than a runtime
         package, so no package depends on another and Core stays pure managed; each host assembly is a
         Core friend, which is what grants the adapter access to the internal SklearnLikeTree. -->
    <Compile Include="..\_shared\MlNetTreeEnsembleAdapter.cs" Link="Internal\MlNetTreeEnsembleAdapter.cs" />
  </ItemGroup>

  <!-- Optional Microsoft.Extensions.DependencyInjection wire-up (OptunaSharp.Integration.MLNet.Extensions).
       Declared directly (the extension uses IServiceCollection) though Core also flows it transitively;
       pure-managed abstractions, version single-sourced in ../../Directory.Build.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDIVersion)" />
  </ItemGroup>

</Project>
