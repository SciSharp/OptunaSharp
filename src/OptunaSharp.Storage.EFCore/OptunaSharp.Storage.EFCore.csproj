<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp.Storage.EFCore</AssemblyName>
    <Nullable>enable</Nullable>

    <PackageId>OptunaSharp.Storage.EFCore</PackageId>
    <Description>PostgreSQL and MySQL RDB storage for OptunaSharp — the Entity Framework Core port of optuna.storages.RDBStorage for server databases. Persists a study with Optuna's exact SQLAlchemy schema (alembic v3.2.0.a, schema_version 12) over Npgsql (PostgreSQL) and Pomelo (MySQL), so Python Optuna and OptunaSharp can share the same PostgreSQL/MySQL database. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;EFCore;EntityFrameworkCore;PostgreSQL;MySQL;RDB;Storage;Database;Npgsql;Pomelo;HyperparameterOptimization;HPO;SciSharp</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The two EF Core providers, TFM-matched so net8.0 stays on the .NET 8 (8.0.x) line and net10.0 on the
       current EF Core 9 line — a net8.0 target should ship .NET 8-era dependencies. The RDB backend binds
       two Npgsql-9-only APIs (NpgsqlDbContextOptionsBuilder.MapEnum, NpgsqlDataSource.ReloadTypes); both
       are #if NET8_0-forked to their EF Core 8 equivalents (model-level HasPostgresEnum in
       OptunaRdbContext.OnModelCreating, and connection-level ReloadTypes in RDBStorage.Initialize) so the
       byte-compat schema is unchanged — the schema DDL is created by RdbSchema's raw SQL (EF-version
       independent) and the enum value conversion rides the data-source MapEnum on both TFMs. Npgsql brings
       native-enum support (studydirection/trialstate/...); Pomelo brings MySqlConnector.
       NOTE: verify with the live-PostgreSQL / MySQL integration tests on net8.0 (Testcontainers) — the
       EF Core 8 enum path is compile-verified but its byte-exact schema behavior needs the DB harness. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

  <!-- Optional Microsoft.Extensions.DependencyInjection wire-up (OptunaSharp.Storages.EFCore.Extensions).
       TFM-matched version from ../../Directory.Build.props (8.0.x on net8.0 — clean, thanks to the EF Core
       provider split above — 10.0.x on net10.0). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
