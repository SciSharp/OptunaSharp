<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp.Storage.Redis</AssemblyName>

    <!-- Shared, CLIENT-AGNOSTIC primitives for the Redis journal backends. No Redis client dependency:
         the StackExchange / NRedisStack / ServiceStack backend packages each reference this and bring
         their own client. Sharing the parser + key layout + Lua text (not an abstraction) is what keeps
         those three byte-identical. -->
    <PackageId>OptunaSharp.Storage.Redis</PackageId>
    <Description>Shared, client-agnostic primitives for the OptunaSharp Redis journal backends: the redis:// URL parser (RedisEndpoint / RedisUrl), the Redis key layout, and the atomic append Lua script (RedisJournalProtocol). No Redis client dependency of its own — the StackExchange / NRedisStack / ServiceStack backend packages build on this. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;Redis;Storage;Journal;HPO;SciSharp</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
