<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp.Storage.StackExchange.Redis</AssemblyName>

    <PackageId>OptunaSharp.Storage.StackExchange.Redis</PackageId>
    <Description>Redis journal-log backend for OptunaSharp on StackExchange.Redis — the de-facto-standard .NET Redis client. StackExchangeJournalRedisBackend persists an Optuna study's operation log to a Redis server (standalone or cluster), byte-compatible with Python Optuna's optuna.storages.journal.JournalRedisBackend. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;Redis;StackExchangeRedis;Storage;Journal;HyperparameterOptimization;HPO;SciSharp</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- TFM-matched StackExchange.Redis so net8.0 does NOT pull the .NET 10-era Microsoft.Extensions graph.
       The ENTIRE 3.x line (3.0.0..3.1.31) depends on Logging.Abstractions 10.0.5, which drags DI
       abstractions to 10.0.x on net8.0; net8.0-clean therefore requires the 2.x line (2.13.17 is the
       latest, and depends on Logging.Abstractions 8.0.x). This is a major-version downgrade on net8.0
       ONLY — 3.1.31 stays on net10.0 — and the journal backend uses only the stable
       IConnectionMultiplexer/IDatabase/ConfigurationOptions surface present in both 2.x and 3.x. The
       Redis journal wire format is client-version-independent, so cross-language byte-compat is unaffected. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <!-- Optional Microsoft.Extensions.DependencyInjection wire-up (OptunaSharp.Storages.Journal.Extensions).
       TFM-matched version from ../../Directory.Build.props (8.0.x on net8.0 — clean, thanks to the
       StackExchange.Redis split above — 10.0.x on net10.0). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptunaSharp.Storage.Redis\OptunaSharp.Storage.Redis.csproj" />
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
