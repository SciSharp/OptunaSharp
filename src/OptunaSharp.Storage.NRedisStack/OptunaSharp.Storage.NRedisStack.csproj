<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp</RootNamespace>
    <AssemblyName>OptunaSharp.Storage.NRedisStack</AssemblyName>

    <PackageId>OptunaSharp.Storage.NRedisStack</PackageId>
    <Description>Redis journal-log backend for OptunaSharp on NRedisStack — Redis's official .NET client. NRedisStackJournalRedisBackend persists an Optuna study's operation log to a Redis server (standalone or cluster), byte-compatible with Python Optuna and the sibling StackExchange/ServiceStack backends. NRedisStack layers the Redis Stack modules on StackExchange.Redis; a journal needs only plain GET/SET/INCR/EVAL, served via the underlying IDatabase. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;Redis;NRedisStack;Storage;Journal;HyperparameterOptimization;HPO;SciSharp</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Redis's official .NET client. Brings StackExchange.Redis transitively (NRedisStack is a superset of
       it); this backend uses the plain IDatabase surface for GET/SET/INCR/EVAL. TFM-matched so net8.0
       does NOT pull the .NET 10-era Microsoft.Extensions graph: NRedisStack 1.6.0+ depends on the
       StackExchange.Redis 3.x line (-> Logging.Abstractions 10.0.5), so net8.0-clean requires 1.5.0 (the
       latest NRedisStack on StackExchange.Redis 2.x). This is a downgrade on net8.0 ONLY — 1.7.4 stays on
       net10.0 — and the backend uses only the stable GetDatabase/IDatabase surface unchanged across both. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="NRedisStack" Version="1.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="NRedisStack" Version="1.7.4" />
  </ItemGroup>

  <!-- Optional Microsoft.Extensions.DependencyInjection wire-up (OptunaSharp.Storages.Journal.Extensions).
       TFM-matched version from ../../Directory.Build.props (8.0.x on net8.0 — clean, thanks to the
       NRedisStack split above — 10.0.x on net10.0). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptunaSharp.Storage.Redis\OptunaSharp.Storage.Redis.csproj" />
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
