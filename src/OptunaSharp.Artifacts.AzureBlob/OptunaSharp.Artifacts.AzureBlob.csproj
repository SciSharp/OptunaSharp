<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OptunaSharp.Artifacts</RootNamespace>
    <AssemblyName>OptunaSharp.Artifacts.AzureBlob</AssemblyName>
    <Nullable>enable</Nullable>

    <PackageId>OptunaSharp.Artifacts.AzureBlob</PackageId>
    <Description>Azure Blob Storage artifact store for OptunaSharp — an OptunaSharp extension (Optuna ships no Azure backend). Backed by the official Azure.Storage.Blobs and Azure.Identity clients; supports connection-string, caller-supplied client, and Microsoft Entra ID (DefaultAzureCredential) construction. OptunaSharp Core stays pure-managed and does not depend on it.</Description>
    <PackageTags>Optuna;OptunaSharp;artifacts;Azure;AzureBlob;BlobStorage;object-storage;HyperparameterOptimization;HPO;SciSharp</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

  <!-- TFM-matched Azure client versions so net8.0 does NOT pull the .NET 10-era Microsoft.Extensions
       graph. The CURRENT Azure.Storage.Blobs 12.29.2 -> Azure.Core 1.55.0 -> Hosting.Abstractions 10.0.3
       drags DI abstractions to 10.0.x on net8.0; the net8.0 line below pins the latest Azure release whose
       Azure.Core (1.47.3) predates that dependency, keeping net8.0 on the 8.0.x DI line. The store uses
       only the stable BlobContainerClient/BlobServiceClient/DefaultAzureCredential surface, unchanged
       across these versions. net10.0 keeps the maintainer-pinned current versions. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <!-- Optional Microsoft.Extensions.DependencyInjection wire-up (OptunaSharp.Artifacts.Extensions).
       TFM-matched version from ../../Directory.Build.props (8.0.x on net8.0 — clean, thanks to the Azure
       version split above — 10.0.x on net10.0). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDIVersion)" />
  </ItemGroup>

</Project>
