<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>OptunaSharp.Interop.Pymoo</AssemblyName>
    <RootNamespace>OptunaSharp.Interop.Pymoo</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet package identity. Shared metadata (Authors/Company/Copyright/RepositoryUrl/license/
         version) is centralized in ../../Directory.Build.props. This is a Tier X satellite that ships
         SEPARATELY because it takes a foreign-runtime dependency (an embedded CPython + the pymoo
         library via pythonnet) — Core stays pure managed (NumSharp only), the
         NumSharp.Interop.OpenBLAS / OptunaSharp.Interop.pythonnet pattern.

         Purpose: PymooSampler as a first-class OptunaSharp sampler that drives the REAL pymoo
         (the multi-objective evolutionary-algorithm library) in-process — one BaseSampler that
         exposes pymoo's whole multi-objective zoo (NSGA-II/III, R-NSGA-II/III, U-NSGA-III,
         AGE-MOEA/AGE-MOEA-2, RVEA, SMS-EMOA, SPEA2, C-TAEA) through a pythonnet-free
         PymooAlgorithm enum. The Optuna side (study, storage, ask/tell, search space) is native
         OptunaSharp; the operators, reference-direction machinery and HV/decomposition survival are
         genuine pymoo, reconstructed generation-by-generation from the study's completed trials and
         driven through pymoo's native ask()/tell(). Built on OptunaSharp.Interop.pythonnet.

         Sibling of OptunaSharp.Interop.BoTorch / .PyCma — the same "reconstruct-from-trials ->
         tell-replay -> ask" bridge PyCmaSampler proves. It does NOT require any Python glue package;
         users install only `pymoo`. Beyond-core: pymoo's MOEAs (bar NSGA-II/III) are not in Optuna,
         so — like the native AgeMoea2Sampler / LM-CMA / JANUS — this is an OptunaSharp extension.
         Validation is behavioral + value-parity vs live pymoo.minimize (NOT bit-exact: the Optuna
         ask/tell + search-space transform differ from a monolithic minimize run). -->
    <PackageId>OptunaSharp.Interop.Pymoo</PackageId>
    <Description>PymooSampler for OptunaSharp — a native OptunaSharp BaseSampler that drives the real pymoo (the multi-objective evolutionary-optimization library) in-process via Python.NET (pythonnet). One sampler exposes pymoo's whole multi-objective algorithm zoo — NSGA-II, NSGA-III, R-NSGA-II, R-NSGA-III, U-NSGA-III, AGE-MOEA, AGE-MOEA-2, RVEA, SMS-EMOA, SPEA2, C-TAEA — through a pythonnet-free PymooAlgorithm enum. The Optuna side (study, storage, ask/tell, search space) is native OptunaSharp; the operators, reference-direction machinery and HV/decomposition survival are genuine pymoo, reconstructed from the study's completed trials and driven through pymoo's native ask()/tell() — the same reconstruct-from-trials bridge as OptunaSharp.Interop.PyCma / .BoTorch. Configurable through PymooAlgorithmOptions: SBX crossover + PM mutation, duplicate elimination, RVEA alpha/adapt_freq, R-NSGA weights/mu/epsilon, and Das-Dennis / Riesz-energy reference directions. Supports constrained optimization (pymoo's G ≤ 0 feasibility, via Trial.SetConstraint or a constraintsFunc) and single-, two- and many-objective studies over Optuna's full parameter space (float/int with log/step, categoricals, dynamic spaces). Beyond Optuna core (Optuna ships only NSGA-II/III), a live-runtime complement to the native AgeMoea2Sampler. Does NOT require any Python glue package — install only `pymoo`. Built on OptunaSharp.Interop.pythonnet. Part of the SciSharp STACK.</Description>
    <PackageTags>Optuna;OptunaSharp;pymoo;NSGA-II;NSGA-III;RVEA;SMS-EMOA;SPEA2;AGE-MOEA;C-TAEA;MOEA;multi-objective;MultiObjective;ConstrainedOptimization;SBX;PolynomialMutation;evolutionary;GeneticAlgorithm;pythonnet;Python.NET;interop;sampler;BlackBoxOptimization;HyperparameterOptimization;HPO;AutoML;SciSharp</PackageTags>

    <!-- Emit the XML doc file (for IntelliSense) but do not fail the build on doc-comment nits. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570;CS1574;CS1587;CS1711;CS1734</NoWarn>

    <!-- Emit the .pdb inside the .nupkg (the release pipeline pushes only *.nupkg). -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>optunasharp-icon.png</PackageIcon>
    <PackageOutputPath>../../packages</PackageOutputPath>

    <!-- Strong-naming (key, SignAssembly, DelaySign) is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Reuse the shared OptunaSharp package icon. -->
    <None Include="..\..\docs\website-src\images\optunasharp-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime plumbing (embedded CPython, GIL wrappers, interpreter discovery, CLR<->Py marshaling)
         comes from the pythonnet interop package; it transitively brings pythonnet [3.0.5,4.0.0). -->
    <ProjectReference Include="..\OptunaSharp.Interop.pythonnet\OptunaSharp.Interop.pythonnet.csproj" />
    <!-- NumSharp's zero-copy pythonnet interop: the NDArray <-> numpy crossing (NDArray.ToNumpy /
         PyObject.ToNDArray) the X/F matrices ride on instead of per-element PyList loops. Version
         single-sourced with Core's NumSharp via $(NumSharpVersion). It requires an already-initialized
         PythonEngine, so it wires onto the SAME embedded engine OptunaSharp.Interop.pythonnet starts
         (it does not start its own). -->
    <PackageReference Include="NumSharp.Interop.pythonnet" Version="$(NumSharpVersion)" />
    <!-- Core is referenced by project; packing records a clean "OptunaSharp" dependency. This package
         is a Core FRIEND (InternalsVisibleTo in Core's Assembly/Properties.cs) so it reuses the
         intersection search space, the SearchSpaceTransform one-hot/unit-cube encoding, the
         distribution compatibility check, and the warning/logging seam. -->
    <ProjectReference Include="..\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
