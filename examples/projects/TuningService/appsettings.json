{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // OptunaSharp's records arrive through TuningCommon's OptunaLoggingBridge, under categories named after
      // Optuna's Python modules (optuna.study.study, ...); this one entry filters all of them
      "optuna": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      // the REST API, the dashboard and the charts: plain HTTP/1.1 for browsers and curl
      "Http": {
        "Url": "http://localhost:5080",
        "Protocols": "Http1"
      },
      // Optuna's gRPC storage proxy: cleartext HTTP/2 (h2c) on Optuna's default port, which is what
      // optuna.storages.GrpcStorageProxy and OptunaSharp's GrpcStorageProxy connect to
      "Grpc": {
        "Url": "http://localhost:13000",
        "Protocols": "Http2"
      }
    }
  },
  "Optuna": {
    "Storage": "sqlite:///tuning.db",
    "Sampler": "TPE",
    "SamplerSeed": null,
    "EpochDelayMilliseconds": 25,
    "MaxTrialsPerJob": 1000,
    "MaxParallelTrials": 16,
    "MaxQueuedJobs": 32
  }
}
