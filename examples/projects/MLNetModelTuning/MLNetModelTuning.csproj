<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console app that tunes a real ML.NET model with OptunaSharp: every trial trains FastTree on five
       cross-validation folds, in-process. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Emit the XML documentation so a missing doc comment on a public member is a CS1591 warning. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- `dotnet run` starts a console app in the caller's directory, so a run from the repository root would
         write ./out there. Start it in the project folder instead, as the Web and Worker SDKs do for the
         other examples. Running the built executable directly still writes ./out under the current directory. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inside this repository the example builds against the current source. Outside it, replace each
         ProjectReference with the NuGet package of the same name. Integration.ML.NET brings Microsoft.ML and
         Microsoft.ML.FastTree, whose native code runs on x64. -->
    <ProjectReference Include="..\..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
    <ProjectReference Include="..\..\..\src\OptunaSharp.Integration.ML.NET\OptunaSharp.Integration.ML.NET.csproj" />
    <ProjectReference Include="..\..\..\src\OptunaSharp.Storage.Sqlite\OptunaSharp.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\..\src\OptunaSharp.Visualization.Plotly\OptunaSharp.Visualization.Plotly.csproj" />
  </ItemGroup>

</Project>
