<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Restore exclusively from nuget.org so builds are reproducible regardless of any
         machine-wide sources a developer may have configured. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
