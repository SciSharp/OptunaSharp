<Project>

  <!-- ====================================================================================
       Shared repository-wide MSBuild properties for OptunaSharp — imported BEFORE every
       project body, so a project's own value always wins (override per project as needed).
       ==================================================================================== -->

  <!-- ====================================================================================
       Strong-name signing — ONE place for every project in the repository.

       WHAT THE KEY IS. `Open.snk` at the repo root is Microsoft's *published* open-source
       strong-name key (596 bytes, sha256 b897629e0b20090c9219ac80392c037fa4cfcc2bdc21d3c45d9bf74b8df0f671),
       byte-for-byte identical to dotnet/arcade's `Open.snk` and to the key NumSharp and
       TensorFlow.NET sign with. Its public key token `cc7b13ffcd2ddd51` is the one carried by
       `netstandard`, `System.Memory`, `System.Buffers` and `System.Runtime.CompilerServices.Unsafe`.
       Microsoft strong-names those with this very key and publishes the PRIVATE half so OSS
       builds can produce strong-named output without its real signing infrastructure.

       SO THIS IS IDENTITY, NOT AUTHENTICITY. An .snk is a bare RSA key pair: no certificate,
       no subject, no issuer, no chain. It lets the loader tell this `OptunaSharp` from someone
       else's and bind versions; it attests NOTHING about origin. Real authenticity is
       Authenticode on the DLLs plus NuGet author signing and is entirely separate from this file.
       => Do NOT treat `InternalsVisibleTo` as an access control. It is not one.

       WHY THIS KEY AND NOT OUR OWN. Sharing Microsoft's open key with the rest of the SciSharp
       STACK keeps OptunaSharp's identity consistent with NumSharp (which it references) and lets
       the same cross-repo `InternalsVisibleTo(..., PublicKey=...)` pattern resolve everywhere.

       Opt out per project with `<SignAssembly>false</SignAssembly>` — this file is imported
       BEFORE the project body, so a project's own value wins.
       ==================================================================================== -->
  <PropertyGroup>
    <SignAssembly Condition="'$(SignAssembly)' == ''">true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Open.snk</AssemblyOriginatorKeyFile>

    <!-- We hold the private half, so sign for real: not delay-signed (which would leave the
         signature blank and require skip-verification registration) and not public-signed. -->
    <DelaySign>false</DelaySign>
    <PublicSign>false</PublicSign>

    <!-- The public key, for `InternalsVisibleTo(..., PublicKey=...)` and anything else that needs
         to name our identity. Kept here so the literal is written down exactly once; the token is
         asserted at build/pack time by .github/scripts/verify_strong_name.cs. -->
    <OptunaSharpPublicKey></OptunaSharpPublicKey>
    <OptunaSharpPublicKeyToken>cc7b13ffcd2ddd51</OptunaSharpPublicKeyToken>
  </PropertyGroup>

  <!-- ====================================================================================
       Shared package + assembly metadata. Every shippable project inherits these; a package
       overrides PackageId/Description/PackageTags with its own. Version is single-sourced here
       and stamped by CI via -p:Version / -p:PackageVersion on release.
       ==================================================================================== -->
  <PropertyGroup>
    <Authors>Eli Belash, SciSharp STACK Team</Authors>
    <Company>SciSharp STACK</Company>
    <Product>OptunaSharp</Product>
    <Copyright>2026 © SciSharp STACK Team</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/SciSharp/OptunaSharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SciSharp/OptunaSharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <LangVersion>latest</LangVersion>

    <!-- Single source of truth for the version across the repo (assembly + package). CI overrides
         all of these from the pushed git tag (see .github/workflows/build-and-release.yml). -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.1.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.1.0</FileVersion>
  </PropertyGroup>

  <!-- ====================================================================================
       NumSharp dependency version — single-sourced for OptunaSharp.Core's two NuGet
       references (NumSharp + NumSharp.Interop.OpenBLAS, both from nuget.org). The matching
       NumSharp source is vendored REFERENCE-ONLY at refs/NumSharp, pinned to the same
       release tag (v$(NumSharpVersion)) for offline browsing / LLM cross-referencing — it is
       NOT part of the build. Bump this one value to move to a newer NumSharp release.
       ==================================================================================== -->
  <PropertyGroup>
    <NumSharpVersion Condition="'$(NumSharpVersion)' == ''">0.70.0</NumSharpVersion>
  </PropertyGroup>

  <!-- ====================================================================================
       Microsoft.Extensions.DependencyInjection.Abstractions version — single-sourced for the
       optional `*.Extensions` DI wire-up shipped by Core and the satellite packages
       (AddOptunaStudyFactory / AddSqliteStorage / AddS3ArtifactStore / AddBoTorchSampler / …).

       TFM-MATCHED VERSIONS (do NOT drag .NET 10-era packages into the net8.0 output). A DI-abstractions
       version tracks the .NET release train, and referencing a 10.0.x from the net8.0 target unifies the
       whole Microsoft.Extensions.* graph UP to the .NET 10 line on a .NET 8 consumer. So the version is
       chosen PER TARGET FRAMEWORK below: the 8.0.x line for net8.0, the 10.0.x line for net10.0. Because
       Directory.Build.props is re-imported in each inner (per-TFM) build, $(TargetFramework) is set when
       these conditions evaluate, so a single $(MicrosoftExtensionsDIVersion)-driven PackageReference
       resolves to the right line for each TFM. (net8.0-clean for 13 of the 18 packages.)

       PER-PACKAGE net8.0 OVERRIDE. A direct reference BELOW a transitive requirement is a package
       DOWNGRADE (NU1605, and this repo builds warnings-as-errors). A few satellites pull a third-party
       lib whose CURRENT version already requires a higher DI on net8.0 (Storage.EFCore -> EF Core 9 ->
       9.0.x, the normal .NET 9 footprint; Artifacts.AzureBlob -> Azure.Core -> 10.0.3;
       Storage.StackExchange.Redis / .NRedisStack -> StackExchange.Redis 3.x -> 10.0.5). Those csprojs
       raise the net8.0 floor by setting $(MicrosoftExtensionsDIVersion) DIRECTLY in a net8.0-conditional
       PropertyGroup (a csproj PropertyGroup is evaluated AFTER this import, so it wins for that TFM; the
       PackageReference item reads the final property value). It is a pure-managed BCL-adjacent package
       (no foreign runtime), so referencing it from Core does not break Core's "no foreign runtime" rule.
       (The gRPC storage package does NOT use this: it gets DI from the ASP.NET Core shared framework.)
       ==================================================================================== -->
  <PropertyGroup>
    <!-- net8.0 -> latest 8.0.x; everything else (net10.0 + the outer multi-target build) -> latest 10.0.x. -->
    <MicrosoftExtensionsDIVersion Condition="'$(MicrosoftExtensionsDIVersion)' == '' and '$(TargetFramework)' == 'net8.0'">8.0.2</MicrosoftExtensionsDIVersion>
    <MicrosoftExtensionsDIVersion Condition="'$(MicrosoftExtensionsDIVersion)' == ''">10.0.12</MicrosoftExtensionsDIVersion>
  </PropertyGroup>

</Project>
