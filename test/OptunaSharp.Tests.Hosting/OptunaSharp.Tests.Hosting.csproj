<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Hosting</RootNamespace>
    <!-- Strong-naming is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.2" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <!-- The DI CONTAINER implementation (ServiceCollection + BuildServiceProvider). The packages under
         test ship only the DI ABSTRACTIONS, so the concrete container is needed to actually register and
         resolve. Version single-sourced (8.0.x on net8.0, 10.0.x on net10.0) in ../../Directory.Build.props. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDIImplementationVersion)" />
  </ItemGroup>

  <!-- THIS PROJECT'S REASON TO EXIST: reference EVERY DI-enabled OptunaSharp package at once so a single
       compilation proves the `*.Extensions` wire-up does NOT clash — several packages deliberately share a
       namespace (Artifacts x4 -> OptunaSharp.Artifacts.Extensions; the three Redis backends ->
       OptunaSharp.Storages.Journal.Extensions), and a duplicate `ServiceCollectionExtensions` type name
       across two referenced assemblies would be a hard CS0433 here. The tests then register every `Add*`
       into one container and resolve the offline-constructible services. (The gRPC package flows the
       ASP.NET Core shared framework transitively; the Interop.* packages flow pythonnet — no Python is
       initialized because the sampler factories are only registered, never resolved, in these tests.) -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Artifacts.S3\OptunaSharp.Artifacts.S3.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Artifacts.Gcs\OptunaSharp.Artifacts.Gcs.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Artifacts.AzureBlob\OptunaSharp.Artifacts.AzureBlob.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Artifacts.R2\OptunaSharp.Artifacts.R2.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Sqlite\OptunaSharp.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.EFCore\OptunaSharp.Storage.EFCore.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Grpc\OptunaSharp.Storage.Grpc.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.StackExchange.Redis\OptunaSharp.Storage.StackExchange.Redis.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.NRedisStack\OptunaSharp.Storage.NRedisStack.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.ServiceStack.Redis\OptunaSharp.Storage.ServiceStack.Redis.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Interop.pythonnet\OptunaSharp.Interop.pythonnet.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Interop.BoTorch\OptunaSharp.Interop.BoTorch.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Interop.PyCma\OptunaSharp.Interop.PyCma.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Interop.Pymoo\OptunaSharp.Interop.Pymoo.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Integration.LightGbm\OptunaSharp.Integration.LightGbm.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Integration.ML.NET\OptunaSharp.Integration.ML.NET.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Visualization.Plotly\OptunaSharp.Visualization.Plotly.csproj" />
  </ItemGroup>

</Project>
