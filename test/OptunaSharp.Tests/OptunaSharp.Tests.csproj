<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests</RootNamespace>
    <!-- Strong-naming is set repo-wide in ../../Directory.Build.props. Signed because
         OptunaSharp.Core grants it InternalsVisibleTo, which names a PublicKey. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- MSTest v3 metapackage: framework + adapter + source-generated discovery. -->
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
    <!-- The DI CONTAINER implementation (ServiceCollection + BuildServiceProvider), needed to exercise
         the OptunaSharp.Extensions / *.Extensions DI wire-up end-to-end. Core ships only the
         abstractions; this brings the concrete container. Version single-sourced in Directory.Build.props. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDIImplementationVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
    <!-- The plotly visualization backend (Phase 5.2) — unit tests assert the rendered plotly figure
         spec (traces + layout) built from the Core data layer. Pure managed (Plotly.NET). -->
    <ProjectReference Include="..\..\src\OptunaSharp.Visualization.Plotly\OptunaSharp.Visualization.Plotly.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Committed SHAP oracle (byte-exact importances from the real optuna_integration.shap
         ShapleyImportanceEvaluator, shap 0.52.0 + scikit-learn; regenerated by oracle/gen_shap_oracle.py).
         Copied next to the test assembly so Importance/ShapleyImportanceEvaluatorTests replays it with
         NO Python. -->
    <None Include="oracle\shap_oracle.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Committed scikit-learn oracle (byte-exact RandomForestRegressor / KFold / cross_validate / r2 +
         end-to-end OptunaSearchCV from real scikit-learn 1.8.0 + optuna_integration; regenerated by
         oracle/gen_sklearn_oracle.py). Copied next to the test assembly so
         Integration/Sklearn/SklearnOracleParityTests replays it with NO Python. -->
    <None Include="oracle\sklearn_oracle.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Committed AGE-MOEA-2 operator oracle (draw-for-draw outputs of pymoo 0.6.1.3's SBX / PM /
         TournamentSelection / Mating / FloatRandomSampling; regenerated by oracle/gen_agemoea2_oracle.py
         in the isolated .venv-pymoo). Copied next to the test assembly so
         Samplers/AgeMoea2OperatorParityTests replays it bit-exactly with NO Python. -->
    <None Include="oracle\agemoea2_operators.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Committed CMA-ES optimizer-state oracle (the exact `cma:optimizer:*` pickles Optuna 5.0.0 stores with
         cmaes 0.13.1 and numpy 2.4.2, plus large codec pickles; regenerated by oracle/gen_cma_pickle_oracle.py).
         Copied next to the test assembly so Samplers/CmaPickleOracleTests checks OptunaSharp's pickle reader,
         writer and stored states byte for byte with NO Python. -->
    <None Include="oracle\cma_pickle_oracle.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
