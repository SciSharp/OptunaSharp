<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Storage</RootNamespace>
    <!-- AssemblyName matches the friend granted in each backend's + Core's Assembly/Properties.cs, so
         these tests reach the internal ToConfiguration mappers, the shared-connection ctors, and Core's
         OptunaWarnings.WarningRaised. Strong-naming is repo-wide in ../../Directory.Build.props. -->
    <AssemblyName>OptunaSharp.Tests.Storage</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
    <!-- Code-coverage collector: the "XPlat Code Coverage" data collector emits cobertura so the
         full-API-coverage of all three backends + the shared parser is measurable. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- All three client backends under test (each transitively brings the shared package + Core +
         its Redis client). The shared package + Core are referenced explicitly too, for RedisUrl.Parse
         / RedisJournalProtocol and JournalStorage / Optuna.CreateStudy used across the suite. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.StackExchange.Redis\OptunaSharp.Storage.StackExchange.Redis.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.NRedisStack\OptunaSharp.Storage.NRedisStack.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.ServiceStack.Redis\OptunaSharp.Storage.ServiceStack.Redis.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Redis\OptunaSharp.Storage.Redis.csproj" />
    <!-- The SQLite RDB storage (Phase 4.1). Needs no external service (native e_sqlite3 is bundled),
         so its tests run in the normal unit-test lane. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Sqlite\OptunaSharp.Storage.Sqlite.csproj" />
    <!-- The gRPC storage proxy (Phase 4.4). Its client↔server round-trip + proto conversions run fully
         in-process (Kestrel on a loopback port), needing no external service or Python, so they run in
         the normal unit-test lane. Brings ASP.NET Core (server host) + Grpc.Net.Client transitively. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Grpc\OptunaSharp.Storage.Grpc.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
