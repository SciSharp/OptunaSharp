<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>OptunaSharp.Tests.Storage</PackageId>
    <!-- AssemblyName matches the friend granted in OptunaSharp.Storage.Redis's Assembly/Properties.cs,
         so these tests can reach the internal RedisUrl adapter + the IConnectionMultiplexer ctor.
         Strong-naming is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
    <!-- Code-coverage collector: the "XPlat Code Coverage" data collector emits cobertura so the
         full-API-coverage of OptunaSharp.Storage.Redis (JournalRedisBackend + RedisUrl) is measurable. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The satellite under test (transitively brings Core + StackExchange.Redis). Core is also
         referenced explicitly for JournalStorage / Optuna.CreateStudy used by the round-trip tests. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Redis\OptunaSharp.Storage.Redis.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
