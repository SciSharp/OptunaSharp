<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OptunaSharp.Tests.PackageParity</RootNamespace>

    <!-- The version to pull from the local feed. CI overrides it with the version it just packed;
         the default matches Directory.Build.props VersionPrefix for local runs. -->
    <OptunaSharpPackageVersion Condition="'$(OptunaSharpPackageVersion)' == ''">0.1.0</OptunaSharpPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
  </ItemGroup>

  <!-- OptunaSharp.Storage.Grpc's server self-hosts on Kestrel, so its .nupkg carries a FrameworkReference
       to Microsoft.AspNetCore.App; a consumer of that package must supply the same shared framework. The
       .NET SDK (local) and the sdk:10.0 CI image both include it. Restore doesn't need it; building the
       net10.0 TFM (and net8.0 locally) does. Referencing it here is exactly what a downstream app pulling
       OptunaSharp.Storage.Grpc has to do. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    THE ISOLATION BOUNDARY: every OptunaSharp package we ship arrives as a PACKAGE from the local feed
    (NuGet.config source-maps OptunaSharp* -> feed), never a ProjectReference — there is no compile path
    from here to src/. Referencing ALL the LIBRARY packages makes this gate prove that each shipped .nupkg
    restores against its real declared dependency graph (its third-party deps come from nuget.org) and
    loads standalone carrying the SciSharp strong-name identity — the exact class of failure that once
    surfaced as NU1101 (an unpublished NumSharp.Interop.OpenBLAS), now covered for the whole set.

    OptunaSharp.Cli is intentionally ABSENT here: it is a `dotnet tool` (PackAsTool) whose .nupkg has no
    lib/ assembly to reference. It is still packed into the feed (below) and is exercised as a tool —
    installed from the feed and run — by PackagedCliToolSmokeTests.
  -->
  <ItemGroup>
    <PackageReference Include="OptunaSharp" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Storage.Sqlite" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Storage.EFCore" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Storage.Grpc" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Storage.Redis" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Storage.StackExchange.Redis" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Storage.NRedisStack" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Storage.ServiceStack.Redis" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Artifacts.S3" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Artifacts.Gcs" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Artifacts.AzureBlob" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Artifacts.R2" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Integration.LightGbm" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Integration.ML.NET" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Interop.pythonnet" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Interop.BoTorch" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Interop.PyCma" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Interop.Pymoo" Version="$(OptunaSharpPackageVersion)" />
    <PackageReference Include="OptunaSharp.Visualization.Plotly" Version="$(OptunaSharpPackageVersion)" />
  </ItemGroup>

  <!--
    ================================================================================================
    AUTO-PACK ALL OPTUNASHARP PACKAGES INTO THE LOCAL FEED  — the "no cryptic NU1301/NU1101" convenience
    ================================================================================================
    WHY THIS EXISTS
      The PackageReferences above (and the Cli tool test) resolve every OptunaSharp package from ./feed
      (see NuGet.config) — a .gitignored folder the package-parity CI pipeline populates just before the
      test container runs. On a plain local build (or any clean checkout) that folder is empty, so restore
      dies with an error nobody can decode without knowing the pipeline:
          NU1301: The local source '...\feed' doesn't exist.   (feed dir missing entirely)
          NU1101: Unable to find package OptunaSharp ...        (feed present but missing a package)
      This target removes that footgun: it packs EVERY packable project under src/ into ./feed BEFORE
      restore, so the very build that would have failed instead produces the packages it needs and
      succeeds. The isolation model is unchanged (each package is still consumed as a PACKAGE).

    WHY IT HOOKS Restore (and not a normal build target)
      A PackageReference is resolved during RESTORE, which runs before every ordinary build target — so a
      build-phase target would be far too late (restore already failed). BeforeTargets="Restore" is the
      only point early enough to drop the .nupkgs in first; CollectPackageReferences is listed too as a
      belt-and-suspenders for SDK/restore variants. MSBuild runs the target at most once per invocation.

    WHAT IT PACKS / NO RECURSION
      It packs $(_SrcDir)\*\*.csproj — every project under src/ (all are packable, Cli included). The
      parity project lives under test/, so it is NEVER in that list: packing cannot re-enter this target.
      First build is a one-time cost (~one `dotnet pack` per package); warm builds skip entirely.

    FRESHNESS (behaves like ProjectReferences would)
      Inputs/Outputs skip the whole target once feed/.packed-all.stamp is newer than every src source
      (warm builds pay nothing) and rerun it when any src changes. All packages share the fixed version
      (0.1.0), and NuGet's global cache would otherwise keep serving the FIRST 0.1.0 of each it ever
      extracted (the local-feed + fixed-version + cache trap), silently testing stale bits — so a repack
      first evicts exactly our extractions (every optunasharp* id at this version) to force re-extraction.
      Blast radius is our package family at one version; nothing else in the cache is touched.

    CI / CONTAINER SAFETY
      Everything is Condition'd on src/ existing. The isolated CI container has the feed pre-dropped and
      NO src/ tree, so the target self-disables there — CI keeps consuming exactly the artifacts it deployed.

    TO FORCE A CLEAN REPACK: delete feed/  (or just feed/.packed-all.stamp).
    ================================================================================================
  -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj')">
    <_SrcDir>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\src'))</_SrcDir>
    <!-- NormalizePath (NOT NormalizeDirectory) yields NO trailing slash: a trailing '\' inside the quoted
         output argument would escape the closing quote on Windows and swallow the rest of the command line. -->
    <_LocalFeedDir>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)feed'))</_LocalFeedDir>
    <_FeedStamp>$([System.IO.Path]::Combine('$(_LocalFeedDir)', '.packed-all.stamp'))</_FeedStamp>
    <!-- Pack in the parity build's configuration; default Release (restore can invoke us with Configuration unset). -->
    <_CorePackConfiguration Condition="'$(Configuration)' != ''">$(Configuration)</_CorePackConfiguration>
    <_CorePackConfiguration Condition="'$(_CorePackConfiguration)' == ''">Release</_CorePackConfiguration>
    <!-- Resolve the NuGet global-packages folder the way NuGet does, with OS-correct fallbacks, so our
         fixed-version extractions can be evicted. (A custom globalPackagesFolder in NuGet.config isn't
         honored here, but none is configured; a miss just no-ops the eviction.) -->
    <_NuGetGlobalPackages Condition="'$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</_NuGetGlobalPackages>
    <_NuGetGlobalPackages Condition="'$(_NuGetGlobalPackages)' == '' and '$(OS)' == 'Windows_NT'">$(USERPROFILE)\.nuget\packages</_NuGetGlobalPackages>
    <_NuGetGlobalPackages Condition="'$(_NuGetGlobalPackages)' == ''">$(HOME)/.nuget/packages</_NuGetGlobalPackages>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(_SrcDir)')">
    <!-- Every packable project under src/ (all are packable; the parity project is under test/, excluded). -->
    <_SrcPackable Include="$(_SrcDir)\*\*.csproj" />
    <!-- Freshness inputs: any src source or the build files that shape the packages. bin/obj are excluded
         so packages' own build output can never retrigger the pack (which would loop). -->
    <_PackInputs Include="$(_SrcDir)\**\*.cs" Exclude="$(_SrcDir)\**\obj\**\*.*;$(_SrcDir)\**\bin\**\*.*" />
    <_PackInputs Include="$(_SrcDir)\*\*.csproj" />
    <_PackInputs Include="$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />
  </ItemGroup>

  <!-- Our cached extractions (all shipped ids start with 'optunasharp', lowercased in the global cache),
       enumerated at eval so a repack can evict exactly the fixed-version subfolder of each. GetDirectories
       is guarded by Exists so it never throws on a missing cache dir. -->
  <ItemGroup Condition="Exists('$(_NuGetGlobalPackages)')">
    <_OurCachedPkgRoot Include="$([System.IO.Directory]::GetDirectories('$(_NuGetGlobalPackages)', 'optunasharp*'))" />
    <_OurCachedPkgVersionDir Include="@(_OurCachedPkgRoot->'%(Identity)/$(OptunaSharpPackageVersion)')" />
  </ItemGroup>

  <Target Name="_PackAllOptunaSharpPackagesIntoLocalFeed"
          BeforeTargets="Restore;CollectPackageReferences"
          Condition="Exists('$(_SrcDir)')"
          Inputs="@(_PackInputs)"
          Outputs="$(_FeedStamp)">
    <Message Importance="high"
             Text="OptunaSharp.Tests.PackageParity: packing ALL OptunaSharp packages from src/ into the local isolation feed (first build / on any src change; one-time cost)..." />
    <!-- Evict our fixed-version extractions so restore cannot serve stale bits from a prior pack. Batches
         over the enumerated dirs; if there are none (nothing cached yet) it is a no-op. -->
    <RemoveDir Directories="@(_OurCachedPkgVersionDir)" Condition="Exists('%(Identity)')" />
    <!-- Pack each packable src project into the feed (one dotnet pack per project, batched over the item).
         PackageVersion pins identity so each feed file name equals the requested version even under CI override. -->
    <Exec Command="dotnet pack &quot;%(_SrcPackable.FullPath)&quot; --configuration $(_CorePackConfiguration) -p:PackageVersion=$(OptunaSharpPackageVersion) --output &quot;$(_LocalFeedDir)&quot; --nologo -clp:ErrorsOnly" />
    <!-- Stamp AFTER a successful pack so a failed pack does not mark the feed fresh. -->
    <Touch Files="$(_FeedStamp)" AlwaysCreate="true" />
  </Target>

</Project>
