<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The isolated package feed. `feed/` (relative to this file) is where CI drops the freshly-built
    OptunaSharp.<version>.nupkg from the `package` stage. `<clear/>` drops any inherited sources so
    nothing else leaks in.

    Source mapping PINS OptunaSharp* to the local feed so the container binds to the package under
    test — never a nuget.org shadow. Its declared dependencies (NumSharp, NumSharp.Interop.OpenBLAS)
    and everything else (MSTest, AwesomeAssertions, ...) come from nuget.org, exactly as a downstream
    consumer would restore them.

    This file is honored only by MSBuild restores (the CLI, including the CI container, which holds this
    folder and no repo root). Rider and Visual Studio read NuGet settings from the SOLUTION folder and
    never from a project folder, so the repo-root NuGet.Config MIRRORS this feed and mapping for them:
    same key ("local-feed"), same patterns. Change one and you must change the other. On the CLI both
    files merge: the <clear/> below drops the root's sources and re-adds the same two, and the mappings
    are identical.
  -->
  <packageSources>
    <clear />
    <add key="local-feed" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-feed">
      <package pattern="OptunaSharp*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
