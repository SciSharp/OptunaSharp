<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The isolated package feed. `feed/` (relative to this file) is where CI drops the freshly-built
    OptunaSharp.<version>.nupkg from the `package` stage. OptunaSharp therefore resolves from the
    LOCAL FEED (never the source project); its transitive deps (NumSharp, OpenBLAS) resolve from
    nuget.org. `<clear/>` drops any inherited sources so nothing else leaks in.
  -->
  <packageSources>
    <clear />
    <add key="local-feed" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
