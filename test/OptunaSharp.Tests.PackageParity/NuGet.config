<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The isolated package feed. `feed/` (relative to this file) is where CI drops the freshly-built
    OptunaSharp.<version>.nupkg AND the journey3 NumSharp / NumSharp.Interop.OpenBLAS packages it was
    built against, from the `package` stage. `<clear/>` drops any inherited sources so nothing else
    leaks in.

    Source mapping PINS OptunaSharp + NumSharp* to the local feed. This is load-bearing: nuget.org
    publishes an OLDER NumSharp 0.60.0 (no np.linalg) and does NOT publish NumSharp.Interop.OpenBLAS
    at all, so without the mapping a restore could shadow the local NumSharp with the stale nuget.org
    one (or fail NU1101). Everything else (MSTest, AwesomeAssertions, ...) still comes from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="local-feed" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-feed">
      <package pattern="OptunaSharp*" />
      <package pattern="NumSharp*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
