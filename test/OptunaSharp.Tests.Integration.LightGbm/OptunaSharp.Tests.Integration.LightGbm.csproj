<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Integration.LightGbm</RootNamespace>
    <!-- AssemblyName matches the friend granted in OptunaSharp.Integration.LightGbm's
         Assembly/Properties.cs (and Core's), so these tests can reach the internal LightGBM backend /
         shared adapter / Core forest machinery if needed. Strong-naming is set repo-wide in
         ../../Directory.Build.props. -->
    <AssemblyName>OptunaSharp.Tests.Integration.LightGbm</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.2" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The committed LightGBM-tuner oracle (bit-exact synthetic-scorer sequence from live Optuna's
         tuner; regenerated by oracle/gen_lightgbm_tuner_oracle.py). Copied next to the test assembly so
         LightGbmTunerParityTests can replay it. -->
    <None Include="oracle\lightgbm_tuner_synth.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The satellite under test (transitively brings Core + ML.NET + native LightGBM). Core is also
         referenced explicitly for Optuna.CreateStudy / RandomSampler / ImportanceFunctions. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Integration.LightGbm\OptunaSharp.Integration.LightGbm.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
