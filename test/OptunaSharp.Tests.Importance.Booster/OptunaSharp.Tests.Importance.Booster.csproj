<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Importance.Booster</RootNamespace>
    <!-- AssemblyName matches the friend granted in OptunaSharp.Integration.ML.NET's
         Assembly/Properties.cs (and Core's), so these tests can reach the internal booster backend /
         shared adapter / Core forest machinery if needed. Strong-naming is set repo-wide in
         ../../Directory.Build.props. -->
    <AssemblyName>OptunaSharp.Tests.Importance.Booster</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.2" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The satellite under test (transitively brings Core + ML.NET). Core is also referenced
         explicitly for Optuna.CreateStudy / RandomSampler / ImportanceFunctions used by the tests. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Integration.ML.NET\OptunaSharp.Integration.ML.NET.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
