<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Integration.Sklearn</RootNamespace>
    <!-- The assembly name is a declared friend of both Core (Assembly/Properties.cs) and the
         OptunaSharp.Integration.Sklearn package, so these tests can assert against the internal
         byte-exact kernels (Metrics.R2Score / MeanSquaredError, the internal forest surface).
         Strong-naming is set repo-wide in ../../Directory.Build.props. -->
    <AssemblyName>OptunaSharp.Tests.Integration.Sklearn</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The committed byte-exact oracle: real scikit-learn 1.8.0 + optuna_integration output
         (predictions, KFold folds, cross_validate scores, and per-trial OptunaSearchCV user attrs),
         captured by oracle/gen_sklearn_oracle.py and replayed with no Python at test time — the
         OptunaSharp.Tests.Oracle model, as the LightGBM tuner does. -->
    <None Include="oracle\sklearn_oracle.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scikit-learn port is pure-managed and lives IN Core (namespace OptunaSharp.Integration.Sklearn,
         alongside OptunaSearchCV — the SHAP precedent: pure-managed integration members live in Core, not a
         separate NuGet). These tests reach Core's internal kernels (Metrics.R2Score / MeanSquaredError,
         CrossValidation.CrossValidate, RandomForestRegressor.Trees) via the friend grant in Core's
         Assembly/Properties.cs. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
