<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Interop</RootNamespace>
    <!-- Strong-naming is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
    <!-- Embedded CPython bridge. This is the ONLY place the suite runs real Optuna in-process to
         assert OptunaSharp matches it. 3.0.5 is pythonnet's practical floor (drives Python 3.7-3.13);
         a Python 3.14 host needs 3.1.0. Tests self-skip (Inconclusive) when no engine is found. -->
    <PackageReference Include="pythonnet" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
    <!-- The Redis journal backend, so the cross-language persistence gate (JournalRedisInteropTests)
         can round-trip a study through Redis against live Python Optuna. Transitively brings
         StackExchange.Redis. Redis-dependent tests self-skip when no server is reachable. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Redis\OptunaSharp.Storage.Redis.csproj" />
    <!-- The forest-based importance evaluators (fANOVA + MDI), so their live ranking-parity vs
         Optuna's scikit-learn-backed evaluators can run in-process. Transitively brings ML.NET.
         Those tests self-skip when scikit-learn is not importable in the Python env. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Importance.Forests\OptunaSharp.Importance.Forests.csproj" />
  </ItemGroup>

</Project>
