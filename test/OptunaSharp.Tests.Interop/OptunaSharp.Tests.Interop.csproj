<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Interop</RootNamespace>
    <!-- Strong-naming is set repo-wide in ../../Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
    <!-- Embedded CPython bridge. This is the ONLY place the suite runs real Optuna in-process to
         assert OptunaSharp matches it. 3.0.5 is pythonnet's practical floor (drives Python 3.7-3.13);
         a Python 3.14 host needs 3.1.0. Tests self-skip (Inconclusive) when no engine is found. -->
    <PackageReference Include="pythonnet" Version="3.0.5" />
    <!-- Live PostgreSQL/MySQL for the Phase 4.2 cross-language gate (Python Optuna ↔ OptunaSharp EF Core
         storage share the same server database). Self-skips without Docker (or the Python DB drivers). -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
    <!-- All three Redis journal backends, so the cross-language gate (JournalRedisInteropTests) can
         round-trip a study through Redis against live Python Optuna with each C# client. Redis-dependent
         tests self-skip when no server (or redis-py) is present. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.StackExchange.Redis\OptunaSharp.Storage.StackExchange.Redis.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.NRedisStack\OptunaSharp.Storage.NRedisStack.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.ServiceStack.Redis\OptunaSharp.Storage.ServiceStack.Redis.csproj" />
    <!-- The SQLite RDB storage (Phase 4.1), so the same-file round-trip gate can open an OptunaSharp
         .db from Python Optuna and vice versa. Needs no external service (native e_sqlite3 bundled);
         self-skips when Python/optuna is absent, like the other RequiresPython tests. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Sqlite\OptunaSharp.Storage.Sqlite.csproj" />
    <!-- The EF Core RDB storage (Phase 4.2), so the cross-language gate opens the same PostgreSQL/MySQL
         database from Python Optuna and OptunaSharp. Needs a live server (Testcontainers) + the Python
         DB drivers (psycopg2, pymysql); self-skips otherwise. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.EFCore\OptunaSharp.Storage.EFCore.csproj" />
    <!-- The gRPC storage proxy (Phase 4.4), so the wire-compat gate (GrpcStorageProxyInteropTests) can
         round-trip a study between an OptunaSharp client/server and a Python Optuna gRPC proxy server in
         both directions. Self-skips when Python/optuna or grpcio is absent, like the other RequiresPython
         tests. Brings ASP.NET Core (server host) + Grpc.Net.Client transitively. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Storage.Grpc\OptunaSharp.Storage.Grpc.csproj" />
    <!-- The ML.NET importance backends (OptunaSharp.Integration.ML.NET): the faithful FastForest
         (fANOVA + MDI) for live ranking-parity vs Optuna's scikit-learn-backed evaluators, plus the
         EXPERIMENTAL gradient boosters (FastTree / FastTreeTweedie) for RANKING-only parity (boosters
         are off-label — never value-parity). Transitively brings ML.NET; those tests self-skip when
         scikit-learn is not importable in the Python env. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Integration.ML.NET\OptunaSharp.Integration.ML.NET.csproj" />
    <!-- The experimental LightGBM importance backend, also RANKING-only vs live Optuna. Brings the
         native LightGBM binary (Microsoft.ML.LightGbm) transitively. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Integration.LightGbm\OptunaSharp.Integration.LightGbm.csproj" />
    <!-- The OptunaHub bridge (OptunaSharp.Interop.pythonnet), so the live end-to-end gate
         (OptunaHubBridgeParityTests) can load real OptunaHub packages via optunahub.load_local_module
         and drive an OptunaSharp study with them. Shares this project's embedded CPython engine; the
         tests self-skip when optunahub or the refs/optunahub-registry submodule is absent. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Interop.pythonnet\OptunaSharp.Interop.pythonnet.csproj" />
    <!-- The BoTorch bridge (OptunaSharp.Interop.BoTorch): BoTorchSamplerParityTests runs an OptunaSharp
         study with the native BoTorchSampler and asserts byte-exact parity against a replay through the
         real optuna_integration.BoTorchSampler in this project's embedded CPython. Self-skips when
         botorch / optuna_integration are absent. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Interop.BoTorch\OptunaSharp.Interop.BoTorch.csproj" />
  </ItemGroup>

</Project>
