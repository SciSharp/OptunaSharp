<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Integration.Pruning</RootNamespace>
    <!-- A declared Core friend (see Core's Assembly/Properties.cs): the tests assert the
         Keras/tf.keras/Lightning missing-metric UserWarning fired via the internal
         OptunaWarnings.WarningRaised event. Strong-naming is set repo-wide in ../../Directory.Build.props. -->
    <AssemblyName>OptunaSharp.Tests.Integration.Pruning</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The satellite under test (pure managed, transitively brings Core). Core is also referenced
         explicitly for Optuna.CreateStudy / pruners / distributions used by the tests. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Integration.Pruning\OptunaSharp.Integration.Pruning.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
