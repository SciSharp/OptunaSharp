<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OptunaSharp.Tests.Integration.Shap</RootNamespace>
    <!-- AssemblyName matches the friend granted in OptunaSharp.Integration.Shap's Assembly/Properties.cs
         (and Core's), so these tests can reach the internal TreeShap kernel / Core forest machinery /
         OptunaWarnings if needed. Strong-naming is set repo-wide in ../../Directory.Build.props. -->
    <AssemblyName>OptunaSharp.Tests.Integration.Shap</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The committed SHAP oracle (byte-exact importances from the real optuna_integration.shap
         ShapleyImportanceEvaluator over shap 0.52.0 + sklearn; regenerated by oracle/gen_shap_oracle.py).
         Copied next to the test assembly so the replay test runs with NO Python. -->
    <None Include="oracle\shap_oracle.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The satellite under test (transitively brings Core). Core is also referenced explicitly for
         Optuna.CreateStudy / RandomSampler. -->
    <ProjectReference Include="..\..\src\OptunaSharp.Integration.Shap\OptunaSharp.Integration.Shap.csproj" />
    <ProjectReference Include="..\..\src\OptunaSharp.Core\OptunaSharp.Core.csproj" />
  </ItemGroup>

</Project>
