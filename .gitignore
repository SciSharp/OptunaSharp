# ---------------------------------------------------------------------------
# OptunaSharp .gitignore — .NET / Visual Studio / Rider
# ---------------------------------------------------------------------------

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Pp]ublish/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# The NuGet packages this repo produces (src/*/PackageOutputPath -> ../../packages)
/packages/
# Root-anchored: this is the build-output dir the CI pack steps write to (artifacts/nuget,
# artifacts/signing-check). It MUST stay anchored with a leading slash — an unanchored `artifacts/`
# also matches src/OptunaSharp.Core/Artifacts/ (case-insensitively on Windows) and silently un-tracks
# that shipping source, breaking a clean checkout / CI build (CS0234).
/artifacts/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
_ReSharper.Caches/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user
*.userprefs

# Build / restore intermediates
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets
msbuild.log
msbuild.err
msbuild.wrn

# Test / coverage output
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage/
[Cc]overage*.json
[Cc]overage*.xml
[Cc]overage*.info

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# Python (pythonnet interop scratch, virtualenvs, caches)
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# OS cruft
.DS_Store
Thumbs.db
*.stackdump

# Example-generated SQLite studies (OptunaHubDashboard.cs writes one for optuna-dashboard)
examples/**/*.db
examples/**/*.db-wal
examples/**/*.db-shm
examples/**/*.db-journal

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# DocFX — generated site output + API metadata (docfx.json output: docs/website)
docs/website/
**/_site/
docs/website-src/api/*.yml
docs/website-src/api/.manifest
docs/website-src/llms.txt
docs/papers/*
!docs/papers/paper-gateway/
/docs/papers/paper-gateway
